+static unsigned int
+tcp_needed_events (HevSocks5SessionTCP *self, int forward, int backward)
+{
+    unsigned int events = 0;
+    if (forward >= 0 && self->queue)
+        events |= POLLOUT;
+    if (backward >= 0 && hev_ring_buffer_get_use_size (self->buffer) <
+                             hev_ring_buffer_get_max_size (self->buffer))
+        events |= POLLIN;
+    return events;
+}
+
+static int
+set_tcp_interest (HevSocks5SessionTCP *self, unsigned int events,
+                  unsigned int *current)
+{
+    HevTask *task = hev_task_self ();
+    int fd = HEV_SOCKS5 (self)->fd;
+    int res;
+    if (events == *current)
+        return 0;
+    if (!events) {
+        /* A full downstream buffer is resumed by TUN ACK callbacks, not by
+         * repeated readability/HUP on the upstream socket. */
+        hev_task_del_fd (task, fd);
+        *current = 0;
+        return 0;
+    }
+    res = hev_task_mod_fd (task, fd, events);
+    if (res < 0)
+        res = hev_task_add_fd (task, fd, events);
+    if (res < 0)
+        return res;
+    *current = events;
+    return 0;
+}
 
