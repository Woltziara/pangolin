 #include "hev-task-io-socket.h"
 
+/* Select the event actually awaited. Permanently writable sockets must not
+ * wake a coroutine that is waiting for incoming bytes on HarmonyOS. */
+static int
+set_wait_interest (int fd, unsigned int events)
+{
+    HevTask *task = hev_task_self ();
+    if (hev_task_mod_fd (task, fd, events) < 0)
+        return hev_task_add_fd (task, fd, events);
+    return 0;
+}
+
