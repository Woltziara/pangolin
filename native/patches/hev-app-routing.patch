+    return data->socks_port ? data->socks_port : default_port;
+}
+
+static int
+app_route_io_yielder (HevTaskYieldType type, void *data)
+{
+    AppRouteWait *wait = data;
+
+    (void)type;
+    if (hev_socks5_get_timeout (HEV_SOCKS5 (wait->session)) == 0)
+        return -1;
+    wait->remaining = hev_task_sleep (wait->remaining);
+    if (!wait->remaining ||
+        hev_socks5_get_timeout (HEV_SOCKS5 (wait->session)) == 0)
+        return -1;
+
+    return 0;
+}
+
+static int
+hev_socks5_session_resolve_app_route (HevSocks5Session *self)
+{
+    HevSocks5SessionData *data = hev_socks5_session_get_data (self);
+    AppFlowBeginFn begin = app_route_begin;
+    AppFlowCancelFn cancel = app_route_cancel;
+    void *opaque = app_route_opaque;
+    AppRouteWait wait = { self, APP_ROUTE_TIMEOUT_MS };
+    AppFlowReply reply;
+    uint64_t request_id = 0;
+    size_t offset = 0;
+    int read_fd;
+    int res = -1;
+
+    if (!begin)
+        return 0;
+    if (!cancel)
+        return -1;
+
+    read_fd = begin (&data->app_flow, &request_id, opaque);
+    if (read_fd == -2) {
+        if (request_id)
+            cancel (request_id, opaque);
+        return 0;
+    }
+    if (read_fd < 0 || !request_id) {
+        if (read_fd >= 0)
+            close (read_fd);
+        if (request_id)
+            cancel (request_id, opaque);
+        return -1;
+    }
+
+    if (hev_task_add_fd (hev_task_self (), read_fd, POLLIN) < 0)
+        goto cleanup;
+
+    while (offset < sizeof (reply)) {
+        ssize_t size;
+
+        size = hev_task_io_read (read_fd, (char *)&reply + offset,
+                                 sizeof (reply) - offset,
+                                 app_route_io_yielder, &wait);
+        if (size <= 0)
+            goto cleanup_registered;
+        offset += size;
+    }
+
+    if (reply.status == 1) {
+        res = 0;
+    } else if (reply.status == 0 && reply.socks_port != 0) {
+        data->socks_port = reply.socks_port;
+        res = 0;
+    }
+
+cleanup_registered:
+    hev_task_del_fd (hev_task_self (), read_fd);
+cleanup:
+    close (read_fd);
+    cancel (request_id, opaque);
+    return res;
+}
